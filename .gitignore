# Dependencies (reinstalled via npm install — never commit)
node_modules/
backend/node_modules/

# Build output
dist/
build/

# Large reference PDFs — not part of the app
/Vol*.pdf

# Secrets / environment (contains real API keys — DO NOT commit)
.env
.env.*
backend/.env
backend/.env.*
!.env.example

# DB drift backup dumps (contain real patient/medical data — DO NOT commit)
backend/drift_tables_backup_*.json

# Uploaded files
backend/uploads/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Prisma local
backend/prisma/*.db

# One-off migration scripts that contain a DB connection string — keep out of git
backend/full-migrate.js
backend/restore-from-render.js

# Everything the audit PRODUCES, as opposed to everything it is made of.
#
# These are regenerated by `bash run-audit.sh` on any machine, and they are large:
# e2e/audit-report alone is 7.9 MB — 51 Lighthouse screenshots, 19 JSON reports and
# 16 run logs — and docs/images is another 2.4 MB. Committed once they are in the
# history forever, they conflict on every parallel run, and a reviewer has to scroll
# past them to reach the twenty files that are actually the change.
#
# The tools that create them are NOT tracked either — e2e/ and docs/ came back out
# at the owner's instruction (see the block below), so this list is now only about
# size, not about what is or is not a deliverable.
e2e/shots/
e2e/audit-report/
docs/images/

# Personal Claude Code permissions — yours, not the repo's
.claude/settings.local.json

# Audit run state — meaningless outside the machine that is running it
.audit.lock
.audit-overnight.pid

# ── Local working material, deliberately not in the repository ────────────────
# Audit harnesses, probe scripts, the findings report and the working notes are
# tools for building this application, not part of it. They were tracked for one
# day and taken back out at the owner's instruction; they still live on the
# machine that runs them.
#
# The ten exceptions below are NOT tooling — package.json or the Render build
# runs each of them by name. Removing any one breaks a build or an npm script,
# so they stay tracked. This list was derived by grepping every manifest in the
# repo, not from memory: storage-report.mjs was dropped on the first attempt
# because it was assumed to live in scripts/ when it lives in backend/scripts/.
e2e/
docs/
CLAUDE.md

# The shell wrappers around e2e/ — same rule, same reason. They only run because
# e2e/ is on this machine, so tracking them would ship four scripts that do
# nothing on a fresh clone.
run-audit.sh
run-audit-overnight.sh
stop-audit.sh
watch-audit.sh

# Screenshots a verification run writes next to the repo root. Named .tmp on
# purpose so a forgotten one is obvious; ignored so a forgotten one is harmless.
*.tmp.png
*.tmp.mjs
scripts/
backend/scripts/*
!backend/scripts/build-clinical-kb.mjs
!backend/scripts/check-drift.mjs
!backend/scripts/ensure-ipd-indexes.mjs
!backend/scripts/fix-prod-billcounter.mjs
!backend/scripts/heal-migrations.mjs
!backend/scripts/hl7-inject.js
!backend/scripts/hl7-simulator.js
!backend/scripts/queue-race.mjs
!backend/scripts/seed-medicine-reference.mjs
!backend/scripts/storage-report.mjs
